# --- Required for full AI mode (all have free tiers) ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Routing is handled by OSRM public demo server — no API key needed
# https://router.project-osrm.org  (free, no signup required)

# --- GloFAS Flood Risk (Open-Meteo — NO API key required) ---
# Live river discharge data for Odisha monitoring points is fetched automatically
# using the Open-Meteo GloFAS flood API, which is completely free and open.
# https://open-meteo.com/en/docs/flood-api

# --- Optional: Copernicus CDS API (Extended GloFAS seasonal forecasts) ---
# If you want longer-range seasonal flood outlooks, register free at:
# https://cds.climate.copernicus.eu  and paste your key below.
# Leave blank to use the default Open-Meteo GloFAS integration (recommended).
COPERNICUS_GLOFAS_API_KEY=

# --- Behaviour ---
DEMO_MODE=true
AUTO_DISPATCH=false
CYCLE_SECONDS=10
RAIN_THRESHOLD_MM=7.5
MAX_ZONE_RADIUS_KM=5
ZONE_TTL_MINUTES=60
SIM_SPEED_KM_PER_STEP=3
DATABASE_URL=sqlite:///./resqchain.db
BACKEND_URL=http://localhost:8000

# --- Sentinel-1 and transparent heuristic flood risk ---
# sample is offline-safe; live uses Microsoft Planetary Computer when optional
# geospatial dependencies and network access are available.
SATELLITE_MODE=sample
SATELLITE_REFRESH_HOURS=6
SATELLITE_EVENT_WINDOW_DAYS=12
SATELLITE_REFERENCE_DAYS=90
SATELLITE_VV_THRESHOLD_DB=-18
SATELLITE_VV_DROP_DB=-3
SATELLITE_MIN_BLOB_AREA_KM2=0.02
SATELLITE_TARGET_RESOLUTION_M=50
SATELLITE_TILE_DEGREES=0.35
RISK_WEIGHT_SATELLITE=0.35
RISK_WEIGHT_RAIN=0.25
RISK_WEIGHT_RIVER=0.20
RISK_WEIGHT_TERRAIN=0.10
RISK_WEIGHT_HISTORY=0.10
RELIEF_DAYS=3
FOOD_KITS_PER_PERSON=0.25
WATER_LITERS_PER_PERSON=15
BLANKETS_PER_PERSON=1
MEDICAL_KITS_PER_PERSON=0.02
PREDICTED_ZONE_TTL_HOURS=24

